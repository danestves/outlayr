@@ -0,0 +1,30 @@
+package expo.modules.widgets
+
+import android.graphics.Color
+
+internal object WidgetNightColors {
+  private val current = ThreadLocal<Map<Int, Int>?>()
+
+  fun <T> using(props: Map<String, Any?>?, block: () -> T): T {
+    val previous = current.get()
+    current.set(parse(props?.get("nightColors")))
+    try {
+      return block()
+    } finally {
+      current.set(previous)
+    }
+  }
+
+  fun night(day: Int): Int? = current.get()?.get(day)
+
+  private fun parse(value: Any?): Map<Int, Int>? {
+    val colors = value as? Map<*, *> ?: return null
+    return colors.entries.mapNotNull { (day, night) ->
+      val dayColor = (day as? String)?.let(::parseColor) ?: return@mapNotNull null
+      val nightColor = (night as? String)?.let(::parseColor) ?: return@mapNotNull null
+      dayColor to nightColor
+    }.toMap()
+  }
+
+  private fun parseColor(value: String): Int? = runCatching { Color.parseColor(value) }.getOrNull()
+}
