# EAS Build upload filter.
#
# This file REPLACES .gitignore for the build upload — the EAS CLI prioritises it
# and stops consulting .gitignore entirely. Everything the four .gitignore files
# exclude is therefore restated here, or it would start being uploaded. Adding a
# line without reading docs/internals/eas-upload.md is how apps/native/ios (1.2 GB of
# prebuild output) ends up in the tarball.

# ── Restated from .gitignore ──────────────────────────────────────────────────

node_modules
.pnp
.pnp.js

dist
build
*.tsbuildinfo

apps/web/src/routeTree.gen.ts

.env
.env*.local
packages/backend/.env.local

.vscode/*
.idea
*.swp
*.swo
*~
.DS_Store

logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

.turbo
.nx
.alchemy
.vercel

coverage
.nyc_output
.argent
.playwright-mcp

*.tgz
.cache
tmp
temp
.atl
.codegraph

# apps/native — the paths here are anchored at the repo root, where
# apps/native/.gitignore anchored them at apps/native.
apps/native/.expo/
apps/native/ios
apps/native/android
apps/native/web-build/
apps/native/.metro-health-check*
apps/native/expo-env.d.ts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# packages/backend/.convex/ holds the local Convex deployment's database and file
# storage (100+ MB). The Convex CLI ignores it with a .gitignore of its own inside
# the directory, which is why it is easy to miss when restating.
packages/backend/.convex/

# Regenerated by Metro from withUniwindConfig({ dtsFile }); shipping a stale copy
# is worse than shipping none.
apps/native/uniwind-types.d.ts

# ── Excluded beyond .gitignore ────────────────────────────────────────────────

# Prose. Nothing imports it.
docs/
**/*.md

# apps/screenshots build output, restated from its own .gitignore: .next alone
# is ~200 MB of Next.js artefacts the native build never reads, and export/ is
# the 45 MB App Store deliverable the editor regenerates.
apps/screenshots/.next/
apps/screenshots/out/
apps/screenshots/export/
apps/screenshots/.impeccable/

apps/clips/out/

# Generated by `intlayer build`, which eas-build-post-install runs on the
# builder anyway — a stale copy would shadow the fresh one.
apps/native/.intlayer/

# Repo tooling that does not run on the builder.
.github/
.claude/
.vscode/
.vite-hooks/

# Local signing assets for `credentialsSource: local`. The EAS CLI reads these
# on this machine and sends the certificate over the credentials channel, so the
# builder never needs them in the tarball. The p12 and .mobileprovision already
# match rules above; credentials.json holds the p12 password and does not.
credentials.json
apps/native/credentials/
