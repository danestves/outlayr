{
    "name": "outlayr",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "vp run -r --cache build",
        "check": "vp check",
        "check-types": "vp run -r --cache check-types",
        "dev": "vp run -r --parallel dev",
        "dev:server": "vp run --filter @outlayr/backend dev",
        "dev:setup": "vp run --filter @outlayr/backend dev:setup",
        "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/",
        "fix": "vp check --fix",
        "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/",
        "prepare": "[ -n \"$CI$EAS_BUILD\" ] || vp config --no-agent",
        "test": "vp run -r --cache test"
    },
    "devDependencies": {
        "@coderabbitai/config": "1.1.5",
        "@effect/language-service": "^0.87.5",
        "@outlayr/config": "workspace:*",
        "@posthog/cli": "^0.18.12",
        "@types/node": "^26.6.5",
        "oxlint-tailwindcss": "^1.17.0",
        "typescript": "catalog:",
        "ultracite": "7.12.2",
        "varlock": "catalog:",
        "vite-plus": "catalog:"
    },
    "packageManager": "pnpm@11.20.0"
}
