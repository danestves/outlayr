# Sequential, not parallel. Both tasks start with `intlayer build`, and two
# concurrent runs write the same generated dictionaries — that race failed the
# native suite at push time even when it passed standalone. Run in order and
# Vite Task's content-addressed cache makes the second `intlayer build` a hit on
# the first rather than a competing writer.
#
# The dispatcher runs this under `sh -e`, so the first failure stops the push.
#
# core.hooksPath skips git-lfs's own hook, so design/captures would push as
# pointers with no objects. It reads the ref list from stdin, so it goes first.
command -v git-lfs >/dev/null 2>&1 || { echo "git-lfs is required to push design/captures: brew install git-lfs"; exit 2; }
git lfs pre-push "$@"
vp run -r --cache check-types
vp run --filter @outlayr/native --cache test --changedSince=origin/main --maxWorkers=25%
vp run --filter '@outlayr/*' --filter '!@outlayr/native' --cache test --changed=origin/main --maxWorkers=25%
