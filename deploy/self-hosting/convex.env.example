# Convex deployment variables. Copy to convex.env. The backend container pushes every uncommented line
# with `convex env set --force` on each start. Leave a feature commented out rather than empty.
# SITE_URL comes from APP_ORIGIN in .env. JWKS is set to empty on first deploy unless you set it here.

# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Sign-in: configure at least one provider.

# Email codes and passwords, sent through Cloudflare Email Sending.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_TOKEN=
# EMAIL_FROM=outlayr@example.com

# Google. Redirect URI: <APP_ORIGIN>/api/auth/callback/google. All three are needed; without an iOS
# client, repeat the web client ID.
# GOOGLE_CLIENT_ID_WEB=
# GOOGLE_CLIENT_ID_IOS=
# GOOGLE_CLIENT_SECRET=

# Apple. Needs an HTTPS APP_ORIGIN.
# APPLE_CLIENT_ID=
# APPLE_WEB_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# AI: receipt and statement scans, CSV and PDF import, enrichment.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL_ID=
# CLAUDE_FAST_MODEL_ID=
# CLAUDE_GROUNDED_MODEL_ID=

# Voice entry transcription.
# ELEVENLABS_API_KEY=

# Exchange rates.
# OXR_APP_ID=
# COTIZAVE_API_KEY=

# Receipt photos (any S3-compatible bucket; R2 is what Outlayr uses).
# R2_BUCKET=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Web push notifications. VAPID key pair: public key and private key as base64url.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Notion import.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# Billing. Without RevenueCat, every account stays on the free plan.
# REVENUECAT_SECRET_KEY=
# REVENUECAT_WEBHOOK_AUTH=
# STRIPE_SECRET_KEY=
# REVENUECAT_STRIPE_PUBLIC_KEY=

# Server-side product analytics.
# POSTHOG_PROJECT_TOKEN=

# Where MCP clients send people to approve a connection. Defaults to <APP_ORIGIN>/connect.
# MCP_CONSENT_URL=
