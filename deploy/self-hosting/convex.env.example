# Convex deployment variables. Copy to convex.env. The backend container pushes every uncommented line
# with `convex env set --force` on each start. Leave a feature commented out rather than empty.
# SITE_URL comes from APP_ORIGIN in .env. JWKS is set to empty on first deploy unless you set it here.

# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Sign-in: email needs no provider. Google and Apple each need theirs.

# Email codes and passwords. Unset EMAIL_PROVIDER uses the first provider with any variable set,
# in the order cloudflare, resend, smtp. With none set, every email, codes included, goes to the
# Convex function logs: the dashboard's Logs page, or `convex logs` with the admin key.
# EMAIL_PROVIDER=
# EMAIL_FROM=outlayr@example.com

# Cloudflare Email Sending.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_TOKEN=

# Resend.
# RESEND_API_KEY=

# SMTP. SMTP_PORT defaults to 587; 465 means implicit TLS.
# SMTP_USERNAME and SMTP_PASSWORD go together or not at all, and need a server with TLS.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Google. Needs an HTTPS APP_ORIGIN on a public domain. Redirect URI: <APP_ORIGIN>/api/auth/callback/google.
# All three are needed; without an iOS client, repeat the web client ID.
# GOOGLE_CLIENT_ID_WEB=
# GOOGLE_CLIENT_ID_IOS=
# GOOGLE_CLIENT_SECRET=

# Apple. Needs an HTTPS APP_ORIGIN.
# APPLE_CLIENT_ID=
# APPLE_WEB_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# AI: receipt and statement scans, CSV and PDF import, enrichment. Anthropic unless
# AI_PROVIDER picks another; see docs/operations/self-hosted-ai.md for each provider.
# ANTHROPIC_API_KEY=
# AI_MODEL_ID=
# AI_FAST_MODEL_ID=
# AI_GROUNDED_MODEL_ID=

# Voice entry transcription. ElevenLabs unless STT_PROVIDER picks another.
# ELEVENLABS_API_KEY=

# Exchange rates.
# OXR_APP_ID=
# COTIZAVE_API_KEY=

# File storage. Unset STORAGE_PROVIDER keeps files in Convex file storage, the default.
# Set it to convex, r2 or s3; with it unset, any R2_* variable selects r2 and any S3_* selects s3.
# STORAGE_PROVIDER=

# Cloudflare R2. Needs R2_ENDPOINT or R2_ACCOUNT_ID; the endpoint comes from the account id.
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Any other S3-compatible bucket (S3, MinIO). S3_REGION defaults to us-east-1 and S3_ENDPOINT to
# https://s3.<region>.amazonaws.com. S3_FORCE_PATH_STYLE=true for MinIO. Credentials fall back to
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, which on their own select nothing.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Web push notifications. VAPID key pair: public key and private key as base64url.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Notion import.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# Billing. Without RevenueCat, every account stays on the free plan unless PRO_ACCOUNTS
# grants Pro: `all` on its own, or a comma-separated list of verified emails.
# PRO_ACCOUNTS=
# REVENUECAT_SECRET_KEY=
# REVENUECAT_WEBHOOK_AUTH=
# STRIPE_SECRET_KEY=
# STRIPE_BANKING_WEBHOOK_SECRET=
# REVENUECAT_STRIPE_PUBLIC_KEY=

# Server-side product analytics.
# POSTHOG_PROJECT_TOKEN=

# Where MCP clients send people to approve a connection. Defaults to <APP_ORIGIN>/connect.
# MCP_CONSENT_URL=
