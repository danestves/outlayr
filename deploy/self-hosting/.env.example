# Compose settings. Copy to .env. The Convex deployment's own variables go in convex.env.

# Image tag: edge (main), a release such as v1.2.3, or latest (newest release, once one exists).
IMAGE_TAG=edge
# IMAGE_REGISTRY=ghcr.io
# IMAGE_OWNER=danestves

# Public URLs. Browsers and the containers both call them: use a domain or the host's LAN IP, never localhost.
APP_ORIGIN=http://192.168.1.10:3080
CONVEX_CLOUD_ORIGIN=http://192.168.1.10:3210
CONVEX_SITE_ORIGIN=http://192.168.1.10:3211

# Host ports, and the address they listen on (127.0.0.1 behind a reverse proxy on the same host).
BIND_ADDRESS=0.0.0.0
APP_PORT=3080
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
DASHBOARD_PORT=6791

# Printed by: docker compose exec convex ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Optional. Empty, the Convex backend generates a secret and keeps it in the convex-data volume.
INSTANCE_NAME=
INSTANCE_SECRET=
# CONVEX_VERSION=cf39368b85da10d95522e27960d57833c048ea56
# DISABLE_BEACON=true

# Source builds only (docker-compose.build.yml): PostHog token for web analytics.
# VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
