# Copy to .env next to docker-compose.yml and fill in.

# Random hex, generate: openssl rand -hex 32
INSTANCE_SECRET=

# From: docker compose exec backend ./generate_admin_key.sh
# Add it after the first boot, then run `docker compose up -d` again.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# URLs users reach the stack on. For a LAN/home server use http://<lan-ip>:<port>.
# The VITE_* pair is baked into the web bundle at build time: changing them later
# needs `docker compose build app` and `docker compose up -d`, not a restart.
CONVEX_CLOUD_ORIGIN=http://localhost:3210
CONVEX_SITE_ORIGIN=http://localhost:3211
SITE_URL=http://localhost:3080
VITE_CONVEX_URL=http://localhost:3210
VITE_CONVEX_SITE_URL=http://localhost:3211

# Host ports. 3210 = Convex API, 3211 = Convex HTTP actions, 6791 = admin
# dashboard, 3080 = web app. Change any that collide on your machine.
API_PORT=3210
SITE_PORT=3211
DASHBOARD_PORT=6791
APP_PORT=3080

INSTANCE_NAME=outlayr
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
