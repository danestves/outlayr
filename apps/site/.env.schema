# @defaultRequired=false
# @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, icons=false)
# ---

# PostHog project token (phc_...). Read in production builds only; without it analytics never starts.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Convex deployment URL (.cloud host). Without it /login and /connect fail to load.
# @type=url
VITE_CONVEX_URL=

# Same deployment's HTTP origin (.site host). The /api/auth proxy forwards to it.
# @type=url
VITE_CONVEX_SITE_URL=
