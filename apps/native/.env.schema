# @defaultRequired=false
# @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, icons=false)
# ---

# Convex deployment URL (.cloud host). Without it currency conversion is unavailable.
# @type=url
EXPO_PUBLIC_CONVEX_URL=

# Same deployment's HTTP origin (.site host). Without it the app offers no account.
# @type=url
EXPO_PUBLIC_CONVEX_SITE_URL=

# Google OAuth web client id. Without it the Google button is not offered.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Google OAuth iOS client id. Reversed into a URL scheme by app.config.ts, so a change needs a rebuild.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=

# logo.dev publishable token. Without it merchant logos fall back to favicons.
EXPO_PUBLIC_LOGO_DEV_TOKEN=

# PostHog project token (phc_...). Without it no client is created and nothing is sent.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=

# RevenueCat public SDK key for Android. Without one nothing is Pro.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# RevenueCat public SDK key for iOS (test_... for the simulator). Without one nothing is Pro.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
