# @defaultRequired=false
# @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, icons=false)
# ---

# PostHog project token (phc_...). Read in production builds only; without it analytics never starts.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Stripe publishable key (pk_...) for linking banks. Without it bank linking is hidden.
VITE_STRIPE_PUBLISHABLE_KEY=

# Convex deployment URL (.cloud host). Without it the dashboard, /login and /connect fail to load.
# A build without it, such as the self-hosting image, reads it from the server's environment at boot.
# @type=url
VITE_CONVEX_URL=

# Same deployment's HTTP origin (.site host). The /api/auth proxy forwards to it. Read at boot like VITE_CONVEX_URL.
# @type=url
VITE_CONVEX_SITE_URL=

# Server-only route to the same deployment's HTTP API, such as the backend container on a shared Docker network.
# Server renders call Convex through it instead of the public host. Unset, they use VITE_CONVEX_URL.
# @type=url
CONVEX_INTERNAL_URL=
